@startuml  
left to right direction

actor "Funcionário/Administrador" as Admin
actor "Espectador" as Cliente

rectangle Sistema {

  usecase "Cadastrar Cinema" as UC1
  usecase "Cadastrar Filme" as UC2
  usecase "Cadastrar Sessão" as UC3
  usecase "Registrar Público" as UC4
  usecase "Consultar Relatórios" as UC5

  usecase "Consultar Filmes" as UC6
  usecase "Consultar Sessões" as UC7
  usecase "Visualizar Detalhes do Filme" as UC8
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5

Cliente --> UC6
Cliente --> UC7
Cliente --> UC8

@enduml